{
  "name": "alpha-dx",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "clear": "pnpm -r exec rimraf node_modules dist .turbo lib && pnpm rimraf node_modules .turbo",
    "test": "vitest run --coverage",
    "update-packages": "pnpm update -i -r --latest",
    "build": "turbo run build",
    "release": "pnpm build && changeset publish",
    "set-release": "changeset",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@alphacifer/biome": "workspace:^",
    "@alphacifer/core-utils": "workspace:^",
    "@alphacifer/slidev-academic-theme": "workspace:^",
    "@alphacifer/slidev-addon-theme": "workspace:^",
    "@alphacifer/tsconfig": "workspace:^",
    "@biomejs/biome": "2.5.7",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@vitest/coverage-istanbul": "4.1.10",
    "@vueuse/motion": "3.0.3",
    "changeset": "0.2.6",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "rimraf": "6.1.3",
    "tsdown": "0.22.14",
    "turbo": "2.10.8",
    "unocss": "66.10.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "4.1.10",
    "vue": "3.5.40"
  }
}
