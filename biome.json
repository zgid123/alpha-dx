{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "extends": [
    "@alphacifer/biome/config"
  ],
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/*.d.ts",
      "!coverage",
      "!**/dist",
      "!**/lib",
      "!**/.turbo",
      "!**/.pnpm-store",
      "!**/.vitepress/.temp",
      "!**/.vitepress/cache",
      "!**/routeTree.gen.ts",
      "!**/node_modules/**/*.ts",
      "!**/node_modules/**/*.tsx"
    ]
  }
}
