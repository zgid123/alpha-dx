{
  "name": "@alphacifer/slidev-academic-theme",
  "version": "0.0.0",
  "description": "Alpha's light-only academic theme for Slidev",
  "type": "module",
  "scripts": {
    "dev": "slidev slides.md --open",
    "preview:build": "slidev build slides.md"
  },
  "keywords": [
    "slidev-theme",
    "slidev",
    "academic"
  ],
  "files": [
    "layouts",
    "setup",
    "slide-bottom.vue",
    "style.css",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Alpha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgid123/alpha-dx.git",
    "directory": "packages/slidev/academic-theme"
  },
  "license": "MIT",
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 980,
      "transition": "slide-left",
      "fonts": {
        "provider": "none",
        "sans": "Inter",
        "serif": "Georgia",
        "mono": "JetBrains Mono"
      }
    }
  },
  "peerDependencies": {
    "@slidev/client": ">=52.18.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@slidev/client": "52.19.0",
    "@slidev/cli": "52.19.0",
    "vue": "3.5.40"
  }
}
